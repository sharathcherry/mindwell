# Environment Variables for MindWell Server

# Tier-2 Multimodal Contextual Intelligence Provider (Pick at least one):
# 1. Google Gemini 2.0 Flash (Recommended - Free via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud (Free Llama 3.3 70B & Whisper Large v3)
GROQ_API_KEY=your_groq_api_key_here

# 3. NVIDIA NIM API Key
NVIDIA_API_KEY=your_nvidia_api_key_here

# Server Port
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Persistent Database Layer
# Zero-config local development with SQLite:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL in production (Neon/Supabase/Render):
# DATABASE_URL="postgresql://user:password@host:5432/mindwell?schema=public&sslmode=require"
