# ==============================================================================
# MindWell Environment Configuration Template
# Copy this file to .env and populate with your credentials before starting.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
# Allowed CORS origins for browser security (comma-separated)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# ------------------------------------------------------------------------------
# 2. Database Persistence Layer (Prisma ORM)
# ------------------------------------------------------------------------------
# SQLite zero-config local development:
# DATABASE_URL="file:./dev.db"

# PostgreSQL for Docker Compose (Default):
DATABASE_URL="postgresql://mindwell:mindwell_secret@localhost:5432/mindwell?schema=public"

# PostgreSQL Serverless (Neon / Supabase / AWS RDS):
# DATABASE_URL="postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/mindwell?sslmode=require&pgbouncer=true"

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Token Lifecycle
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret keys for HMAC-SHA256 signing
JWT_SECRET=replace_with_a_secure_random_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_min_32_chars

# ------------------------------------------------------------------------------
# 4. Multimodal AI & Acoustic Processing Providers
# ------------------------------------------------------------------------------
# Google Gemini 2.0 Flash (Recommended - 1,500 free req/day from Google AI Studio)
# Powers Tier-2 Multimodal Empathy Cascade & Zero-Dep Serverless Audio SER
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API (Free Llama 3.3 70B Versatile & Whisper Large v3 STT)
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM API (Optional high-performance fallback LLM)
NVIDIA_API_KEY=your_nvidia_api_key_here

# ------------------------------------------------------------------------------
# 5. Acoustic SER Service Routing
# ------------------------------------------------------------------------------
# Dedicated PyTorch HuBERT acoustic SER microservice endpoint
AUDIO_API_URL=http://localhost:3002/api/audio/process

# ------------------------------------------------------------------------------
# 6. Frontend Vite Client Environment (Build / Runtime)
# ------------------------------------------------------------------------------
# Base API path for REST endpoints (leave empty or /api for relative reverse proxy)
VITE_API_BASE_URL=/api

# Direct audio processing endpoint (or leave /api/audio/process for proxy routing)
VITE_AUDIO_API_URL=/api/audio/process

# ------------------------------------------------------------------------------
# 7. Docker Compose PostgreSQL Credentials
# ------------------------------------------------------------------------------
POSTGRES_DB=mindwell
POSTGRES_USER=mindwell
POSTGRES_PASSWORD=mindwell_secret
