{
  "name": "mindwell-root",
  "version": "2.0.0",
  "description": "MindWell - Two-Tier Multimodal AI Mental Wellness Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node run_smoke_tests.js",
    "test:security": "node test/run-security-tests.js",
    "test:server": "cd server && npm test",
    "test:db": "node server/test/test-db.js",
    "test:client": "cd client && npm test",
    "test:audio": "cd python_audio && python test_audio_endpoint.py",
    "build": "cd client && npm run build",
    "build:all": "npx prisma generate --schema=server/prisma/schema.prisma && cd client && npm run build",
    "prisma:generate": "npx prisma generate --schema=server/prisma/schema.prisma",
    "start": "cd server && npm start",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "serverless-http": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
